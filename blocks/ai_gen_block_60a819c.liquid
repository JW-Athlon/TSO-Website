{% doc %}
  @prompt
    a text-based section that has a table with 2 columns , add 9 more rows, center the text in their columns, center the heading and make it medium size, and create a vertical line separating the columns, here's the information to put in each box:
    Specification	TSO-LM1
    Product Name	Doppler Radar Golf Swing Monitor
    Part Number	TSO-LM1
    SKU	T401001
    Radar Technology	Doppler Radar
    Max. Speed	Up to 199 mph
    Display Type	Sunlight-Readable LCD
    Resolution	400 × 300
    Display Area	3.34 × 2.50 in
    Backlight	None
    Battery	Rechargeable Battery
    Shot History	Stores Up to 500 Shots
    Operating Temperature	-4°F to 158°F
    Storage Temperature	-22°F to 176°F
    Dimensions	5.31 × 3.35 × 0.94 in
    Weight	5.6 oz
    , keep everything the same but center the table in the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    color: #020912;
    font-family: inherit;
  }
  .ai-text-table-{{ ai_gen_id }}__heading {
    color: #3a5eab;
    margin: 0 0 16px;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 500;
    text-align: center;
  }
  .ai-text-table-{{ ai_gen_id }}__intro { margin: 0 0 20px; line-height: 1.6; }
  .ai-text-table-{{ ai_gen_id }}__scroll {
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    overflow-x: auto;
    border: 1px solid rgba(2, 9, 18, 0.18);
  }
  .ai-text-table-{{ ai_gen_id }}__table { width: 100%; border-collapse: collapse; text-align: center; }
  .ai-text-table-{{ ai_gen_id }}__table th,
  .ai-text-table-{{ ai_gen_id }}__table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(2, 9, 18, 0.16);
    vertical-align: middle;
  }
  .ai-text-table-{{ ai_gen_id }}__table th:first-child,
  .ai-text-table-{{ ai_gen_id }}__table td:first-child { border-right: 1px solid rgba(2, 9, 18, 0.28); }
  .ai-text-table-{{ ai_gen_id }}__table th { background: #1c293a; color: #ffffff; font-weight: 700; }
  .ai-text-table-{{ ai_gen_id }}__table tr:last-child td { border-bottom: 0; }
  .ai-text-table-{{ ai_gen_id }}__table tbody tr:nth-child(even) { background: #f4f6f8; }
  @media screen and (max-width: 749px) {
    .ai-text-table-{{ ai_gen_id }}__heading { font-size: 21px; }
    .ai-text-table-{{ ai_gen_id }}__table th,
    .ai-text-table-{{ ai_gen_id }}__table td { padding: 11px 12px; }
  }
{% endstyle %}

<div class="ai-text-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-text-table-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.intro != blank %}<div class="ai-text-table-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>{% endif %}
  <div class="ai-text-table-{{ ai_gen_id }}__scroll">
    <table class="ai-text-table-{{ ai_gen_id }}__table">
      <thead><tr><th scope="col">{{ block.settings.column_one_heading | escape }}</th><th scope="col">{{ block.settings.column_two_heading | escape }}</th></tr></thead>
      <tbody>
        {% for i in (1..15) %}
          {% assign left_key = 'row_' | append: i | append: '_left' %}
          {% assign right_key = 'row_' | append: i | append: '_right' %}
          {% assign left_value = block.settings[left_key] %}
          {% assign right_value = block.settings[right_key] %}
          {% if left_value != blank or right_value != blank %}<tr><td>{{ left_value | escape | newline_to_br }}</td><td>{{ right_value | escape | newline_to_br }}</td></tr>{% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Text table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product specifications" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Technical details for the TSO-LM1 Doppler Radar Golf Swing Monitor.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Table columns" },
    { "type": "text", "id": "column_one_heading", "label": "First column heading", "default": "Specification" },
    { "type": "text", "id": "column_two_heading", "label": "Second column heading", "default": "TSO-LM1" },
    { "type": "header", "content": "Table rows" },
    { "type": "text", "id": "row_1_left", "label": "Row 1, first column", "default": "Product Name" },
    { "type": "text", "id": "row_1_right", "label": "Row 1, second column", "default": "Doppler Radar Golf Swing Monitor" },
    { "type": "text", "id": "row_2_left", "label": "Row 2, first column", "default": "Part Number" },
    { "type": "text", "id": "row_2_right", "label": "Row 2, second column", "default": "TSO-LM1" },
    { "type": "text", "id": "row_3_left", "label": "Row 3, first column", "default": "SKU" },
    { "type": "text", "id": "row_3_right", "label": "Row 3, second column", "default": "T401001" },
    { "type": "text", "id": "row_4_left", "label": "Row 4, first column", "default": "Radar Technology" },
    { "type": "text", "id": "row_4_right", "label": "Row 4, second column", "default": "Doppler Radar" },
    { "type": "text", "id": "row_5_left", "label": "Row 5, first column", "default": "Max. Speed" },
    { "type": "text", "id": "row_5_right", "label": "Row 5, second column", "default": "Up to 199 mph" },
    { "type": "text", "id": "row_6_left", "label": "Row 6, first column", "default": "Display Type" },
    { "type": "text", "id": "row_6_right", "label": "Row 6, second column", "default": "Sunlight-Readable LCD" },
    { "type": "text", "id": "row_7_left", "label": "Row 7, first column", "default": "Resolution" },
    { "type": "text", "id": "row_7_right", "label": "Row 7, second column", "default": "400 × 300" },
    { "type": "text", "id": "row_8_left", "label": "Row 8, first column", "default": "Display Area" },
    { "type": "text", "id": "row_8_right", "label": "Row 8, second column", "default": "3.34 × 2.50 in" },
    { "type": "text", "id": "row_9_left", "label": "Row 9, first column", "default": "Backlight" },
    { "type": "text", "id": "row_9_right", "label": "Row 9, second column", "default": "None" },
    { "type": "text", "id": "row_10_left", "label": "Row 10, first column", "default": "Battery" },
    { "type": "text", "id": "row_10_right", "label": "Row 10, second column", "default": "Rechargeable Battery" },
    { "type": "text", "id": "row_11_left", "label": "Row 11, first column", "default": "Shot History" },
    { "type": "text", "id": "row_11_right", "label": "Row 11, second column", "default": "Stores Up to 500 Shots" },
    { "type": "text", "id": "row_12_left", "label": "Row 12, first column", "default": "Operating Temperature" },
    { "type": "text", "id": "row_12_right", "label": "Row 12, second column", "default": "-4°F to 158°F" },
    { "type": "text", "id": "row_13_left", "label": "Row 13, first column", "default": "Storage Temperature" },
    { "type": "text", "id": "row_13_right", "label": "Row 13, second column", "default": "-22°F to 176°F" },
    { "type": "text", "id": "row_14_left", "label": "Row 14, first column", "default": "Dimensions" },
    { "type": "text", "id": "row_14_right", "label": "Row 14, second column", "default": "5.31 × 3.35 × 0.94 in" },
    { "type": "text", "id": "row_15_left", "label": "Row 15, first column", "default": "Weight" },
    { "type": "text", "id": "row_15_right", "label": "Row 15, second column", "default": "5.6 oz" }
  ],
  "presets": [{ "name": "Text table" }],
  "tag": null,
  "class": "text-table-block"
}
{% endschema %}
    "faq_bino": {
      "type": "tso-faq",
      "blocks": {
        "faq_1": {
          "type": "item",
          "settings": {
            "question": "What does 10x42 mean?",
            "answer": "<p>The first number is magnification: 10X makes distant objects appear 10 times closer. The second is the objective lens diameter, 42 mm. Larger lenses let in more light.</p>"
          }
        },
        "faq_2": {
          "type": "item",
          "settings": {
            "question": "Are the Marlin HD binoculars waterproof?",
            "answer": "<p>Yes. The Marlin HD is fully sealed, so it can withstand being submerged in water.</p>"
          }
        },
        "faq_3": {
          "type": "item",
          "settings": {
            "question": "What is the field of view?",
            "answer": "<p>The field of view is 5.7°, which is 293 ft wide at 1,000 yards. A wider field of view makes it easier to find and follow your subject.</p>"
          }
        },
        "faq_4": {
          "type": "item",
          "settings": {
            "question": "How close can I focus?",
            "answer": "<p>The close focus distance is 23 ft.</p>"
          }
        },
        "faq_5": {
          "type": "item",
          "settings": {
            "question": "What is the eye relief?",
            "answer": "<p>The eye relief is 14.7 mm. Eye relief is how far your eye can sit from the eyepiece and still see the full image; more is generally more comfortable, especially for people who wear glasses.</p>"
          }
        },
        "faq_6": {
          "type": "item",
          "settings": {
            "question": "Will it fit my eyes?",
            "answer": "<p>The interpupillary distance (the spacing between the two barrels) adjusts from 57–76 mm, which suits most adults.</p>"
          }
        },
        "faq_7": {
          "type": "item",
          "settings": {
            "question": "How big and heavy is it?",
            "answer": "<p>It measures 6 × 5.12 in (height × width) and weighs 23.8 oz.</p>"
          }
        },
        "faq_8": {
          "type": "item",
          "settings": {
            "question": "What is it best for?",
            "answer": "<p>The Marlin HD is a good fit for bird watching, hunting, whale watching, sporting events, and travel.</p>"
          }
        },
        "faq_9": {
          "type": "item",
          "settings": {
            "question": "Can I use it on a tripod?",
            "answer": "<p>Yes. It is tripod adaptable, using a standard tripod adapter (sold separately), for steady, hands-free viewing during long observation sessions.</p>"
          }
        },
        "faq_10": {
          "type": "item",
          "settings": {
            "question": "What is your warranty and return policy?",
            "answer": "<p>All TSO binoculars are covered by a 3-year limited warranty. [Return policy details to be added.]</p>"
          }
        }

    "faq_bino": {
      "type": "tso-faq",
      "blocks": {
        "faq_1": {
          "type": "item",
          "settings": {
            "question": "What does 10x50 mean?",
            "answer": "<p>The first number is magnification: 10X makes distant objects appear 10 times closer. The second is the objective lens diameter, 50 mm. Larger lenses let in more light.</p>"
          }
        },
        "faq_2": {
          "type": "item",
          "settings": {
            "question": "Are the Polar HD binoculars waterproof?",
            "answer": "<p>The Polar HD is rainproof rather than fully waterproof. Its nitrogen-purged construction protects the internal optics from moisture, so it is built for rain, mist, and humid conditions. We don’t recommend submerging it.</p>"
          }
        },
        "faq_3": {
          "type": "item",
          "settings": {
            "question": "What is the field of view?",
            "answer": "<p>The field of view is 6.8°, which is 360 ft wide at 1,000 yards. A wider field of view makes it easier to find and follow your subject.</p>"
          }
        },
        "faq_4": {
          "type": "item",
          "settings": {
            "question": "How close can I focus?",
            "answer": "<p>The close focus distance is 26.2 ft.</p>"
          }
        },
        "faq_5": {
          "type": "item",
          "settings": {
            "question": "What is the eye relief?",
            "answer": "<p>The eye relief is 12 mm. Eye relief is how far your eye can sit from the eyepiece and still see the full image; more is generally more comfortable, especially for people who wear glasses.</p>"
          }
        },
        "faq_6": {
          "type": "item",
          "settings": {
            "question": "Will it fit my eyes?",
            "answer": "<p>The interpupillary distance (the spacing between the two barrels) adjusts from 56–72 mm, which suits most adults.</p>"
          }
        },
        "faq_7": {
          "type": "item",
          "settings": {
            "question": "How big and heavy is it?",
            "answer": "<p>It measures 6.65 × 7.7 in (height × width) and weighs 29 oz. The 50 mm objective lenses gather more light than the smaller models in the line.</p>"
          }
        },
        "faq_8": {
          "type": "item",
          "settings": {
            "question": "What is it best for?",
            "answer": "<p>The Polar HD is a good fit for bird watching, wildlife viewing, hunting, hiking, and sporting events.</p>"
          }
        },
        "faq_9": {
          "type": "item",
          "settings": {
            "question": "Can I use it on a tripod?",
            "answer": "<p>Yes. It is tripod adaptable, using a standard tripod adapter (sold separately), for steady, hands-free viewing during long observation sessions.</p>"
          }
        },
        "faq_10": {
          "type": "item",
          "settings": {
            "question": "What is your warranty and return policy?",
            "answer": "<p>All TSO binoculars are covered by a 3-year limited warranty. [Return policy details to be added.]</p>"
          }
        }
      },

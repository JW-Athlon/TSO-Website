{% doc %}
  @prompt
    a text-based section that has a table with 2 columns , add 9 more rows
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #020912;
    font-family: inherit;
  }

  .ai-text-table-{{ ai_gen_id }}__heading {
    color: #3a5eab;
    margin: 0 0 16px;
    font-size: 24px;
    line-height: 1.25;
  }

  .ai-text-table-{{ ai_gen_id }}__intro {
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .ai-text-table-{{ ai_gen_id }}__scroll {
    width: 100%;
    overflow-x: auto;
    border: 1px solid rgba(2, 9, 18, 0.18);
  }

  .ai-text-table-{{ ai_gen_id }}__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .ai-text-table-{{ ai_gen_id }}__table th,
  .ai-text-table-{{ ai_gen_id }}__table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(2, 9, 18, 0.16);
    vertical-align: top;
  }

  .ai-text-table-{{ ai_gen_id }}__table th {
    background: #1c293a;
    color: #ffffff;
    font-weight: 700;
  }

  .ai-text-table-{{ ai_gen_id }}__table tr:last-child td {
    border-bottom: 0;
  }

  .ai-text-table-{{ ai_gen_id }}__table tbody tr:nth-child(even) {
    background: #f4f6f8;
  }

  @media screen and (max-width: 749px) {
    .ai-text-table-{{ ai_gen_id }}__heading {
      font-size: 21px;
    }

    .ai-text-table-{{ ai_gen_id }}__table th,
    .ai-text-table-{{ ai_gen_id }}__table td {
      padding: 11px 12px;
    }
  }
{% endstyle %}

<div class="ai-text-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-text-table-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.intro != blank %}
    <div class="ai-text-table-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>
  {% endif %}
  <div class="ai-text-table-{{ ai_gen_id }}__scroll">
    <table class="ai-text-table-{{ ai_gen_id }}__table">
      <thead>
        <tr>
          <th scope="col">{{ block.settings.column_one_heading | escape }}</th>
          <th scope="col">{{ block.settings.column_two_heading | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..15) %}
          {% assign left_key = 'row_' | append: i | append: '_left' %}
          {% assign right_key = 'row_' | append: i | append: '_right' %}
          {% assign left_value = block.settings[left_key] %}
          {% assign right_value = block.settings[right_key] %}
          {% if left_value != blank or right_value != blank %}
            <tr>
              <td>{{ left_value | escape | newline_to_br }}</td>
              <td>{{ right_value | escape | newline_to_br }}</td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Text table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Add a short introduction for this table.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Table columns" },
    { "type": "text", "id": "column_one_heading", "label": "First column heading", "default": "Feature" },
    { "type": "text", "id": "column_two_heading", "label": "Second column heading", "default": "Details" },
    { "type": "header", "content": "Table rows" },
    { "type": "text", "id": "row_1_left", "label": "Row 1, first column", "default": "Specification" },
    { "type": "text", "id": "row_1_right", "label": "Row 1, second column", "default": "Add details" },

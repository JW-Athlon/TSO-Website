{{ 'tso-sections.css' | asset_url | stylesheet_tag }}
<div class="tso tso-specs">
  <div class="page-width">
    <div class="tso-specs__layout">
      <div class="tso-specs__intro">
        {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="tso-display">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.pills != blank -%}
          <div class="tso-specs__pills">
            {%- assign pills = section.settings.pills | split: ',' -%}
            {%- for pill in pills -%}<span>{{ pill | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.ratings != blank -%}
          <div class="tso-ratings">
            {%- assign rating_rows = section.settings.ratings | newline_to_br | split: '<br />' -%}
            {%- for row in rating_rows -%}
              {%- assign rc = row | split: '|' -%}
              {%- if rc.size > 1 -%}
                {%- assign score = rc[1] | strip | plus: 0 -%}
                <div class="tso-rating">
                  <div class="tso-rating__head"><span>{{ rc[0] | strip }}</span><strong>{{ score }}<small>/10</small></strong></div>
                  <div class="tso-rating__bar" role="img" aria-label="{{ rc[0] | strip }}: {{ score }} out of 10">
                    {%- for i in (1..10) -%}{%- assign half_point = i | minus: 0.5 -%}<i{% if i <= score %} class="on"{% elsif half_point == score %} class="half"{% endif %}></i>{%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <table class="tso-specs__table">
        <caption>{{ section.settings.caption }}</caption>
        <tbody>
          {%- assign rows = section.settings.rows | newline_to_br | split: '<br />' -%}
          {%- for row in rows -%}
            {%- assign cells = row | split: '|' -%}
            {%- if cells.size > 1 -%}
              <tr><td>{{ cells[0] | strip }}</td><td>{{ cells[1] | strip }}</td></tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSO specifications",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The numbers, clearly" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "pills", "label": "Pills (comma separated)" },
    { "type": "textarea", "id": "ratings", "label": "Ratings (one per line: Label | score from 1 to 10)" },
    { "type": "text", "id": "caption", "label": "Table caption", "default": "Complete product specifications" },
    { "type": "textarea", "id": "rows", "label": "Rows (one per line: Label | Value)" }
  ],
  "presets": [{ "name": "TSO specifications" }]
}
{% endschema %}
 

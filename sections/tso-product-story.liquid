{{ 'tso-sections.css' | asset_url | stylesheet_tag }}
<div class="tso tso-pstory{% if section.settings.image_shape == 'portrait' %} tso-pstory--portrait{% endif %}">
  <div class="page-width">
    <div class="tso-pstory__grid">
      <div class="tso-pstory__image">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', alt: section.settings.image.alt }}
        {%- endif -%}
        {%- if section.settings.stamp != blank -%}<span class="tso-pstory__stamp">{{ section.settings.stamp }}</span>{%- endif -%}
      </div>
      <div class="tso-pstory__copy">
        {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="tso-display">{{ section.settings.heading }}</h2>{%- endif -%}
        {{ section.settings.text }}
        <div class="tso-pstory__callouts">
          {%- for block in section.blocks -%}
            <div class="tso-pstory__callout" {{ block.shopify_attributes }}>
              <span class="tso-pstory__tick" aria-hidden="true">✓</span>
              <div><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSO product story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "stamp", "label": "Image label (orange tag)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "image_shape", "label": "Image shape", "default": "square", "options": [{ "value": "square", "label": "Square panel" }, { "value": "portrait", "label": "Portrait (4:5)" }] }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "TSO product story" }]
}
{% endschema %}

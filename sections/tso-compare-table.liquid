{{ 'tso-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols = 'Coral HD|Marlin HD|Polar HD|Turbine HD' | split: '|'
  assign links = '/products/tso-coral-10x25-compact-binoculars|/products/marlin-hd-10x42-bird-watching-binoculars|/products/tso-polar-hd-10x50-binoculars|/products/turbine-hd-10x42-roof-prism-binoculars' | split: '|'
  assign rows = 'Model~TSO Coral HD (T114001)~TSO Marlin HD (T111001)~TSO Polar HD (T113001)~TSO Turbine HD (T112001)^Magnification~10×~10×~10×~10×^Objective Lens Diameter~25 mm~42 mm~50 mm~42 mm^Prism Type~Porro prism~Roof prism~Porro prism~Roof prism^Coating~Anti-reflective~Multi-coated~Anti-reflective~—^Exit Pupil~2.5 mm~4.2 mm~5 mm~4.2 mm^Diopter Adjustment~—~±5~±3~—^Focus Type~—~—~—~Center focus^Field of View (Angular)~5.5°~5.7°~6.8°~5.6°^Field of View @ 1,000 yd~289 ft~293 ft~360 ft~294 ft^Close Focus~13.1 ft~23 ft~26.2 ft~26 ft^Interpupillary Distance~56–75 mm~57–76 mm~56–72 mm~57–72 mm^Eye Relief~10.5 mm~14.7 mm~12 mm~15.5 mm^Dimensions (H × W)~3.8 × 4.9 in~6 × 5.12 in~6.65 × 7.7 in~5.9 × 5.15 in^Weight~9.5 oz~23.8 oz~29 oz~18.8 oz^Waterproofing~Rainproof, nitrogen-purged~Waterproof, fully sealed (submersible)~Rainproof, nitrogen-purged~Rainproof, nitrogen-purged' | split: '^'
-%}

<div class="tso tso-compare">
  <div class="page-width tso-compare__inner">
    <div class="tso-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="tso-display">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="tso-compare__wrap">
      <table class="tso-compare__table">
        <thead>
          <tr>
            <th>Specification</th>
            {%- for c in cols -%}<th><a href="{{ links[forloop.index0] }}">{{ c }}</a></th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign cells = row | split: '~' -%}
            <tr>
              {%- for cell in cells -%}<td>{{ cell }}</td>{%- endfor -%}
            </tr>
          {%- endfor -%}
          <tr>
            <td>Price</td>
            {%- for l in links -%}
              {%- assign handle = l | split: '/products/' | last -%}
              <td><strong>{{ all_products[handle].price | money }}</strong></td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}<p class="tso-compare__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TSO compare table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Side-by-side details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare the collection." },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Use the table to see where each model differs. Specifications are shown as published on the product pages." },
    { "type": "textarea", "id": "note", "label": "Footnote", "default": "A dash indicates a specification that is not listed on that product’s page. Rainproof models are nitrogen-purged; the Marlin HD is listed as fully sealed and submersible." }
  ],
  "presets": [{ "name": "TSO compare table" }]
}
{% endschema %}

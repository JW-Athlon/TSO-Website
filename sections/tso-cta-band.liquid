{{ 'tso-sections.css' | asset_url | stylesheet_tag }}
<div class="tso tso-cta">
  {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  <h2 class="tso-display">{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  {%- if section.settings.button_label != blank -%}
    <a class="tso-btn tso-btn--outline-dark" href="{{ section.settings.button_link | default: '#tso-buy' }}">{{ section.settings.button_label }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "TSO call to action",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link (use #tso-buy to scroll to the purchase area)", "default": "#tso-buy" }
  ],
  "presets": [{ "name": "TSO call to action" }]
}
{% endschema %}

{{ 'tso-sections.css' | asset_url | stylesheet_tag }}
<div class="tso tso-icards{% if section.settings.image_ratio == 'portrait' %} tso-icards--portrait{% endif %}{% if section.settings.columns == '3' %} tso-icards--3{% endif %}">
  <div class="page-width">
    <div class="tso-head tso-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="tso-display">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
    <div class="tso-icards__grid">
      {%- for block in section.blocks -%}
        <article class="tso-icard" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="tso-icard__media">{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', alt: block.settings.title }}</div>
          {%- endif -%}
          <div class="tso-icard__body">
            {%- if block.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSO image cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "square", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait (4:5)" }] },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "2", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }] }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "TSO image cards" }]
}
{% endschema %}

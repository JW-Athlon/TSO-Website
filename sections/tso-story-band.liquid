{{ 'tso-sections.css' | asset_url | stylesheet_tag }}

<div class="tso tso-story{% if section.settings.image_position == 'right' %} tso-story--right{% endif %}">
  <div class="tso-story__photo">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 750px) 50vw, 100vw' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="tso-story__copy">
    {%- if section.settings.eyebrow != blank -%}<span class="tso-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="tso-display">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="tso-btn tso-btn--blue" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}>{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TSO story band",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "select", "id": "image_position", "label": "Photo position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For the moments that matter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take in the bigger picture." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Bird watching, camping, hiking, travel, or a day at the game: the right optic helps you stay connected to the experience." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your binoculars" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "TSO story band" }]
}
{% endschema %}
